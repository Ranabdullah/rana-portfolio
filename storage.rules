rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /sites/{site}/media/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/sites/$(site)/admins/$(request.auth.uid)).data.enabled == true
        && request.resource != null && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('(image/(png|jpeg|webp)|video/mp4)');
    }
  }
}
